{% comment %} mt-product-detail-grid: 4-photo grid below product reviews {% endcomment %}
{%- if section.blocks.size > 0 -%}
<div id="shopify-section-{{ section.id }}" class="mt-detail-grid" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.heading != blank -%}
    <h2 class="mt-detail-grid__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="mt-detail-grid__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'photo' -%}
        <div class="mt-detail-grid__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="mt-detail-grid__image-wrap">
              {{ block.settings.image | image_url: width: 600 | image_tag:
                loading: 'lazy',
                widths: '300, 400, 600',
                sizes: '(max-width: 749px) calc(50vw - 24px), 25vw',
                alt: block.settings.label | escape
              }}
            </div>
          {%- else -%}
            <div class="mt-detail-grid__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}
          {%- if block.settings.icon != blank or block.settings.label != blank -%}
            <div class="mt-detail-grid__caption">
              {%- if block.settings.icon != blank -%}
                <span class="mt-detail-grid__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <span class="mt-detail-grid__label">{{ block.settings.label }}</span>
              {%- endif -%}
              {%- if block.settings.sublabel != blank -%}
                <span class="mt-detail-grid__sublabel">{{ block.settings.sublabel }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.background_color | default: 'transparent' }};
  }
  .mt-detail-grid__heading {
    text-align: center;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: .04em;
    text-transform: uppercase;
    margin: 0 auto 2rem;
    padding: 0 1rem;
  }
  .mt-detail-grid__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (max-width: 749px) {
    .mt-detail-grid__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }
  .mt-detail-grid__item {
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,.10);
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .mt-detail-grid__image-wrap {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  .mt-detail-grid__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
  }
  .mt-detail-grid__item:hover .mt-detail-grid__image-wrap img {
    transform: scale(1.04);
  }
  .mt-detail-grid__placeholder {
    aspect-ratio: 1 / 1;
    background: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mt-detail-grid__placeholder .placeholder-svg {
    width: 60%;
    height: 60%;
    opacity: .3;
  }
  .mt-detail-grid__caption {
    padding: 10px 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mt-detail-grid__icon {
    font-size: 1.4rem;
    line-height: 1;
  }
  .mt-detail-grid__label {
    font-size: .85rem;
    font-weight: 700;
    color: #222;
  }
  .mt-detail-grid__sublabel {
    font-size: .75rem;
    color: #666;
    line-height: 1.3;
  }
</style>

{% schema %}
{
  "name": "Detail Photo Grid",
  "tag": "section",
  "class": "mt-detail-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Customers Love It"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "sublabel",
          "label": "Sub-label",
          "default": "On all orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Detail Photo Grid",
      "blocks": [
        {
          "type": "photo",
          "settings": {
            "label": "Free Shipping",
            "sublabel": "On all orders over $50"
          }
        },
        {
          "type": "photo",
          "settings": {
            "label": "30-Day Guarantee",
            "sublabel": "Full refund, no questions asked"
          }
        },
        {
          "type": "photo",
          "settings": {
            "label": "Easy Returns",
            "sublabel": "Hassle-free return process"
          }
        },
        {
          "type": "photo",
          "settings": {
            "label": "Secure Checkout",
            "sublabel": "256-bit SSL encryption"
          }
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
