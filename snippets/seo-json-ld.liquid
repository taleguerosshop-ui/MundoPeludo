{%- liquid
  assign shop_url = shop.url
  assign next_year = 'now' | date: '%Y' | plus: 1
-%}

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":{{ shop.name | json }},"url":{{ shop_url | json }}}
</script>

<script type="application/ld+json">
{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop_url | json }}{% if settings.logo != blank %},"logo":{{ settings.logo | image_url: width: 400 | prepend: 'https:' | json }}{% endif %}}
</script>

{%- if template.name == 'product' -%}
{%- liquid
  assign p = product
  assign pv = p.selected_or_first_available_variant
  assign mr_avg = p.metafields.loox.avg_rating.value | default: blank | strip
  assign mr_count = p.metafields.loox.num_reviews.value | default: 0
  assign has_rating = false
  unless mr_avg == blank or mr_count == 0
    assign has_rating = true
  endunless
  assign p_desc = p.description | strip_html | strip_newlines | truncatewords: 80
  assign p_img = p.featured_image | image_url: width: 1200 | prepend: 'https:'
  assign p_url = shop_url | append: p.url
  assign p_price = pv.price | divided_by: 100.0
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p.title | json }},
  "url": {{ p_url | json }},
  "description": {{ p_desc | json }},
  "image": [{{ p_img | json }}],
  "sku": {{ pv.sku | default: pv.id | json }},
  "brand": { "@type": "Brand", "name": {{ p.vendor | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ p_url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ p_price }}",
    "priceValidUntil": "{{ next_year }}-12-31",
    "availability": "{% if p.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "condition": "https://schema.org/NewCondition",
    "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
  }
  {%- if has_rating -%}
  ,"aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "{{ mr_avg }}",
    "reviewCount": "{{ mr_count }}",
    "bestRating": "5",
    "worstRating": "1"
  }
  {%- endif -%}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} }
    {%- if p.collections.first != blank -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ p.collections.first.title | json }}, "item": {{ shop_url | append: p.collections.first.url | json }} }
    ,{ "@type": "ListItem", "position": 3, "name": {{ p.title | json }}, "item": {{ p_url | json }} }
    {%- else -%}
    ,{ "@type": "ListItem", "position": 2, "name": {{ p.title | json }}, "item": {{ p_url | json }} }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- if template.name == 'collection' -%}
{%- assign col = collection -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop_url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ col.title | json }}, "item": {{ shop_url | append: col.url | json }} }
  ]
}
</script>
{%- endif -%}
